{
    "name": "dipesh79/laravel-pg-reset-sequences",
    "description": "Artisan command to reset PostgreSQL sequences after importing a SQL dump",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "postgresql",
        "postgres",
        "sequence",
        "reset",
        "artisan"
    ],
    "authors": [
        {
            "name": "Dipesh Khanal",
            "email": "dipeshkhanal79@gmail.com",
            "homepage": "https://khanaldipesh.com.np",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Dipesh79\\PgResetSequences\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dipesh79\\PgResetSequences\\ResetSequencesServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}